# Copia este archivo a .env y completá los valores.
# NUNCA commitees .env (está en .gitignore).

# Postgres (coincide con docker-compose.yml)
AGRO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/agro

# Clave del proveedor LLM (Gemini API — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Secret compartido con agro-iam (HS256). El mismo valor en ambos servicios.
JWT_SECRET=change-me

# Puerto HTTP (default 8080)
PORT=8080